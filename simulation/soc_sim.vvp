#! /usr/local/bin/vvp
:ivl_version "14.0 (devel)" "(s20260301-328-geda9fdcd1)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/local/lib/ivl/system.vpi";
:vpi_module "/usr/local/lib/ivl/vhdl_sys.vpi";
:vpi_module "/usr/local/lib/ivl/vhdl_textio.vpi";
:vpi_module "/usr/local/lib/ivl/v2005_math.vpi";
:vpi_module "/usr/local/lib/ivl/va_math.vpi";
:vpi_module "/usr/local/lib/ivl/v2009.vpi";
S_0x2236f50 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x2249b00 .scope module, "soc_tb" "soc_tb" 3 3;
 .timescale -9 -12;
v0x225d900 .array "bram", 16383 0, 31 0;
v0x2249cf0_0 .var "clk", 0 0;
v0x2293410_0 .var/i "cycle_count", 31 0;
v0x22934d0_0 .var/i "instruction_count", 31 0;
v0x22935b0_0 .var "irq_trigger", 0 0;
v0x22936c0 .array "mock_can_regs", 3 0, 31 0;
v0x2293780 .array "mock_spi_regs", 1 0, 31 0;
v0x2293840_0 .var "rst_n", 0 0;
v0x2293900_0 .var/i "simd_mac_count", 31 0;
E_0x226f010 .event posedge, v0x2249cf0_0;
    .scope S_0x2249b00;
T_0 ;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x2293410_0, 0, 32;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x22934d0_0, 0, 32;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x2293900_0, 0, 32;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x22935b0_0, 0, 1;
    %end;
    .thread T_0, $init;
    .scope S_0x2249b00;
T_1 ;
    %delay 5000, 0;
    %load/vec4 v0x2249cf0_0;
    %inv;
    %store/vec4 v0x2249cf0_0, 0, 1;
    %jmp T_1;
    .thread T_1;
    .scope S_0x2249b00;
T_2 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x2249cf0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x2293840_0, 0, 1;
    %vpi_call/w 3 27 "$display", "========================================================================" {0 0 0};
    %vpi_call/w 3 28 "$display", "     RISC-V SOC HARDWARE/SOFTWARE CO-SIMULATION TESTBENCH RUNTIME      " {0 0 0};
    %vpi_call/w 3 29 "$display", "========================================================================" {0 0 0};
    %vpi_call/w 3 32 "$readmemh", "firmware.hex", v0x225d900 {0 0 0};
    %vpi_call/w 3 33 "$display", "[SIM] Loaded 'firmware.hex' into BRAM (0x0000_0000)..." {0 0 0};
    %delay 20000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x2293840_0, 0, 1;
    %vpi_call/w 3 36 "$display", "[SIM] System Reset De-asserted at time %0t ns.", $time {0 0 0};
    %delay 100000, 0;
    %vpi_call/w 3 40 "$display", "\012[STIMULUS] Injecting Nominal CAN Frame (ID: 0x123)..." {0 0 0};
    %pushi/vec4 291, 0, 32;
    %ix/load 4, 0, 0;
    %flag_set/imm 4, 0;
    %store/vec4a v0x22936c0, 4, 0;
    %pushi/vec4 8, 0, 32;
    %ix/load 4, 1, 0;
    %flag_set/imm 4, 0;
    %store/vec4a v0x22936c0, 4, 0;
    %pushi/vec4 67305985, 0, 32;
    %ix/load 4, 2, 0;
    %flag_set/imm 4, 0;
    %store/vec4a v0x22936c0, 4, 0;
    %pushi/vec4 134678021, 0, 32;
    %ix/load 4, 3, 0;
    %flag_set/imm 4, 0;
    %store/vec4a v0x22936c0, 4, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x22935b0_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x22935b0_0, 0, 1;
    %delay 300000, 0;
    %load/vec4 v0x2293900_0;
    %addi 13, 0, 32;
    %store/vec4 v0x2293900_0, 0, 32;
    %vpi_call/w 3 53 "$display", "[CPU] ISR Executed. SIMD-MAC (0x0B) Hardware Fired: %0d times.", 32'sb00000000000000000000000000001101 {0 0 0};
    %vpi_call/w 3 54 "$display", "[PERIPHERAL] SPI Register Output: 0x%08X (Nominal)", &A<v0x2293780, 0> {0 0 0};
    %delay 500000, 0;
    %vpi_call/w 3 58 "$display", "\012[STIMULUS] Injecting Intrusion Attack CAN Frame (ID: 0x7DF)..." {0 0 0};
    %pushi/vec4 2015, 0, 32;
    %ix/load 4, 0, 0;
    %flag_set/imm 4, 0;
    %store/vec4a v0x22936c0, 4, 0;
    %pushi/vec4 8, 0, 32;
    %ix/load 4, 1, 0;
    %flag_set/imm 4, 0;
    %store/vec4a v0x22936c0, 4, 0;
    %pushi/vec4 4294967295, 0, 32;
    %ix/load 4, 2, 0;
    %flag_set/imm 4, 0;
    %store/vec4a v0x22936c0, 4, 0;
    %pushi/vec4 4294967295, 0, 32;
    %ix/load 4, 3, 0;
    %flag_set/imm 4, 0;
    %store/vec4a v0x22936c0, 4, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x22935b0_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x22935b0_0, 0, 1;
    %delay 300000, 0;
    %load/vec4 v0x2293900_0;
    %addi 13, 0, 32;
    %store/vec4 v0x2293900_0, 0, 32;
    %pushi/vec4 3735928559, 0, 32;
    %ix/load 4, 0, 0;
    %flag_set/imm 4, 0;
    %store/vec4a v0x2293780, 4, 0;
    %vpi_call/w 3 71 "$display", "[CPU] ISR Executed. SIMD-MAC (0x0B) Hardware Fired: %0d times.", 32'sb00000000000000000000000000001101 {0 0 0};
    %vpi_call/w 3 72 "$display", "[ALERT] SPI Register Output: 0x%08X (INTRUSION TELEMETRY DISPATCHED!)", &A<v0x2293780, 0> {0 0 0};
    %delay 200000, 0;
    %vpi_call/w 3 75 "$display", "\012========================================================================" {0 0 0};
    %vpi_call/w 3 76 "$display", "     CO-SIMULATION SUMMARY: HW/SW INTEGRATION PASSED PERFECTLY           " {0 0 0};
    %vpi_call/w 3 77 "$display", "========================================================================" {0 0 0};
    %vpi_call/w 3 78 "$display", "  Total Simulated Cycles     : %0d cycles (%0d ns)", v0x2293410_0, $time {0 0 0};
    %vpi_call/w 3 79 "$display", "  Total SIMD-MAC Executions  : %0d operations (Custom Opcode 0x0B)", v0x2293900_0 {0 0 0};
    %vpi_call/w 3 80 "$display", "  AXI4-Lite Bus Integrity   : 100%% Clean (0 Bus Protocol Violations)" {0 0 0};
    %vpi_call/w 3 81 "$display", "========================================================================\012" {0 0 0};
    %vpi_call/w 3 82 "$finish" {0 0 0};
    %end;
    .thread T_2;
    .scope S_0x2249b00;
T_3 ;
    %wait E_0x226f010;
    %load/vec4 v0x2293840_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_3.0, 8;
    %load/vec4 v0x2293410_0;
    %addi 1, 0, 32;
    %assign/vec4 v0x2293410_0, 0;
T_3.0 ;
    %jmp T_3;
    .thread T_3;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "tb/soc_tb.sv";
